# manjuel settings. Copy to `.env` -- it is gitignored and never printed (LAW 9).
# An existing shell variable always wins over a line here.
#
# THE OLD CHAINKIT_* NAMES STILL WORK, carried to their MANJUEL_ twins. Written
# with the current names because the old ones in a .env were NOT carried until
# 2026-09-09: the carry ran at import and .env is read after it, so a
# CHAINKIT_ line here did nothing at all. Fixed, and named properly regardless.

MANJUEL_KEEP_ALIVE=30m      # how long Ollama holds a model after a request
MANJUEL_VRAM_GB=15          # usable VRAM. manjuel will not warm a model if
                            # doing so would evict one another client is using.
# MANJUEL_NO_WARM=1         # skip warming models at launch
# MANJUEL_SEAT_MODEL=gpt-oss:20b  # when a tag agents/ or skills/ declares is not
                            # installed, every seat sits on this one instead
                            # (off: refuse the boot, as before)
# MANJUEL_GIT_REMOTE=1      # allow git pull/push (off by default -- remote
                            # writes cross the wall to somewhere the operator
                            # did not fetch it)
# MANJUEL_RACK_PULL=1       # allow rack_pull to DOWNLOAD models (off by default)
# MANJUEL_ROUTE_ANTHROPIC_KEY=   # the key of the hosted route in us/route_anthropic.us. OFF without
                            # it: nothing is ever sent. Put it here yourself; it is never printed,
                            # copied, logged or typed by a hand (RULE 7). Only `/parity hosted` uses
                            # the route, and it says what leaves and asks first.
# MANJUEL_SEAT_TIMEOUT=     # seconds a seat with no Timeout: of its own may take (600)
# MANJUEL_SKILL_TIMEOUT=    # seconds a skill may run
# MANJUEL_TURN_DEADLINE=    # seconds for a whole turn (600); a pipeline may declare its own
# MANJUEL_LOG_HORIZON_DAYS= # how far back the log reader looks
# MANJUEL_NO_COLOR=1        # plain output, no ink
# MANJUEL_WHISPER_MODEL=    # the faster-whisper model name (default base.en)
# MANJUEL_WHISPER_DIR=      # where its weights live
# MANJUEL_WHISPER_CLI=      # path to whisper-cli(.exe)
# MANJUEL_WHISPER_GGML=     # path to ggml-*.bin
# ---------------------------------------------------------------------
# These do NOT work here. The `ollama serve` process reads them when IT
# starts, so a value written here reaches manjuel and never reaches Ollama.
# manjuel will tell you it ignored them rather than pretend.
#
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_MAX_LOADED_MODELS=6
#
# Ollama is already running on your desktop, so set these as Windows system
# environment variables and restart the Ollama app for them to take effect.
#
# NOTE: MAX_LOADED_MODELS is a CAP, not a reservation. With 6 allowed on a 16GB
# card, VRAM is still the binding constraint -- Ollama evicts on memory
# pressure long before it hits six. Raising the cap does not create room.
# ---------------------------------------------------------------------

# Voice (optional). Speaking out needs nothing on Windows -- SAPI is built in.
# Listening in needs a microphone library:  pip install sounddevice
#
# Transcription NEVER downloads a model, and needs NO configuration: a
# whisper.cpp build near the ground is found automatically, weights and all.
# MANJUEL_WHISPER_CLI, _GGML and _DIR, above, only exist to override that
# search, and are not normally needed.
# Wider spellcheck coverage (optional, the built-in table works without it):
#   pip install pyspellchecker

# ---------------------------------------------------------------------
# MCP servers (optional). Each dial names one LOCAL MCP server and makes it
# callable from a seat through the `mcp_call` skill: the part after
# MANJUEL_MCP_ is the name a seat uses.
#
# THE ADDRESS MUST BE LOOPBACK. The estate is local (RULE 4) and mcp_call
# refuses anything else by name without sending a byte. There is no dial that
# turns that off, and the address itself is never printed or echoed back --
# every line the skill returns names the SERVER, not this value.
#
# MANJUEL_MCP_ATLAS=http://127.0.0.1:8090/rpc
# MANJUEL_MCP_ATLAS_KEY=     # the key this ground presents to ATLAS once its door
                            # demands one (`--auth`); never printed, never a server
# ---------------------------------------------------------------------

# The bound on a `run_python` child, in seconds (default 60). This is a REAL
# kill, not a wait: the process is terminated at the deadline and whatever it
# had already printed is still reported. Raise it only for work that is
# genuinely long, never to get past a script that loops.
# MANJUEL_RUN_TIMEOUT=60

# ---------------------------------------------------------------------
# Steward's driver (/drive) and the face. Unset, each takes the default shown.
# MANJUEL_DRIVER_MODEL=gpt-oss:20b      # the model the driver runs on
# MANJUEL_DRIVER_FALLBACK=qwen3.5:9b    # takes over when the first keeps failing
# MANJUEL_SUMMARY_MODEL=qwen3.5:4b      # writes the summaries when a job's window is compacted
# MANJUEL_DRIVER_THINK=                 # 1/0, or low/medium/high; unset, gpt-oss at low, others off
# MANJUEL_DRIVER_DIALECT=native         # the tool-call form the driver reads (manjuel/dialects.py)
# MANJUEL_DRIVER_STEPS=30               # steps in one job
# MANJUEL_DRIVER_MINUTES=45             # minutes in one job
# MANJUEL_DRIVER_ITEMS=25               # items in one job, at most
# MANJUEL_DRIVER_ITEM_STEPS=15          # steps for one item
# MANJUEL_DRIVER_ITEM_MINUTES=15        # minutes for one item
# MANJUEL_DRIVER_CTX=                   # the window; unset, read off the model and the card
# MANJUEL_DRIVER_CTX_MAX=32768          # the most that reading may give
# MANJUEL_DRIVER_CONTEXT_CHARS=5000     # the law, standing, story and memory handed beside the goal
# MANJUEL_DRIVER_CARRY=3000             # what earlier jobs did, carried into the next, in characters
# MANJUEL_DRIVER_CHECK_SECONDS=900      # the bound on a job's check
# MANJUEL_DRIVER_CI_SECONDS=1800        # the bound on watching a pull request's checks
# MANJUEL_DRIVER_ALLOW=                 # tools, comma-separated, that write without a card
# MANJUEL_DRIVER_DENY=                  # tools, comma-separated, never run
# MANJUEL_CARD_WAIT=1800                # seconds with no answer on a card, and it is a no
# MANJUEL_FACE=steward                  # who answers at the door; council puts the council in front
# MANJUEL_FACE_STEPS=12                 # steps in one turn at the face
# MANJUEL_FACE_MINUTES=10               # minutes in one turn at the face
